{
  "description": "DeepSeek mini-router: task-aware spec/react/flash persona at session start, complexity-adaptive per-turn guidance, re-anchor after compaction, and best-effort trajectory report.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/anchor-session.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 3000,
            "statusMessage": "DeepSeek mini-router"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/maintain-mode.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 2500,
            "statusMessage": "DeepSeek mode guidance"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/re-anchor.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 1500,
            "statusMessage": "DeepSeek re-anchor (pre-compact)"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/re-anchor.mjs\"",
            "timeout": 10,
            "additionalContextLimit": 3000,
            "statusMessage": "DeepSeek re-anchor (post-compact)"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/report-trajectory.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
